{
	"schemaVersion": 1,
	"id": "madoku-craft-hud",
	"version": "${version}",
	"name": "Madoku Craft HUD",
	"description": "A configurable HUD overhaul system.",
	"authors": [
		"Monkeyopolis"
	],
	"contact": {
		"homepage": "https://github.com/Monkeyopolis/Madoku-Craft-HUD"
	},
	"license": "CC0-1.0",
	"icon": "assets/madoku-craft-hud/icon.png",
	"environment": "*",
	"mixins": [
		"madoku-craft-hud.mixins.json"
	],
	"entrypoints": {
		"main": [
			"madoku.craft.hud.Madokucrafthud"
		],
		"client": [
			"madoku.craft.hud.MadokucrafthudClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.5",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"madoku-craft-api": "${madoku_craft_api_mod_version}"
	}
}
